<?xml version="1.0" encoding="utf-8"?>
<!--
  LyricCar 歌词 —— 车机端歌词显示 App（纯 Android 原生实现）。

  * 歌曲信息来自系统媒体会话（MediaSession），需要「通知使用权」而不是普通权限；
  * 歌词本体存在应用私有目录（<files>/carlyric/lyrics.json），不需要权限；
  * 导出 / 导入写系统「下载」目录：Android 9 及以下需要
    WRITE_EXTERNAL_STORAGE，Android 10 起走 MediaStore，不需要权限；
  * 局域网传输由 App 自己起一个 HTTP 服务，所以需要 INTERNET。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 悬浮歌词：浮在导航 / 桌面之上，需要「显示在其他应用上层」。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务维持悬浮窗（Android 14 起必须声明类型）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 开机后按上次的开关恢复悬浮歌词。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ 的前台服务通知；不主动申请，没授权也能正常显示歌词。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      读取蓝牙 A2DP Sink 的 MediaBrowserService（Android 11+ 的包可见性声明）。
      常见的是 com.android.bluetooth；有的 ROM 换了包名 / 类名，所以再按
      MediaBrowserService 的 intent 查一遍，顺带列上几个常见的厂商蓝牙包。
    -->
    <queries>
        <package android:name="com.android.bluetooth" />
        <package android:name="com.byd.bluetooth" />
        <package android:name="com.byd.bt" />
        <package android:name="com.qualcomm.bluetooth" />
        <!-- 比亚迪「智能加速」白名单页：悬浮歌词需要引导用户把 App 加进去。 -->
        <package android:name="com.byd.rapidmode" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".LyricCarApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LyricCar">

        <!--
          不锁横屏：竖着的屏幕、车机「平行世界」里被挤成竖条的窗口都能用，
          布局会跟着窗口形状换成「上歌词 / 下控制条」。
          配置变化（转屏、窗口改大小）交给系统重建 Activity —— 歌词库和正在采集的
          歌词都活在 Application 里，重建不会丢。
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.LyricCar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          一行通知都不处理，只是用来拿到读取其他 App MediaSession 的「钥匙」。
          Android 规定：只有已启用的 NotificationListenerService 才能通过
          MediaSessionManager.getActiveSessions() 读到别的播放器的元数据。
        -->
        <service
            android:name=".MediaSessionListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          悬浮歌词：前台服务 + 系统级悬浮窗，浮在导航 / 桌面之上。
          Android 14 起前台服务必须声明类型，specialUse 用于这种「持续显示浮层」的场景。
        -->
        <service
            android:name=".overlay.LyricOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating lyrics overlay over navigation apps" />
        </service>

        <!-- 开机恢复：只在用户开过悬浮歌词、且仍有悬浮窗权限时才会拉起服务。 -->
        <receiver
            android:name=".overlay.OverlayBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
